                <span class="text-white font-bold text-sm tracking-wide bg-brand-dark/40 px-3 py-1.5 rounded-full backdrop-blur-xs">Catering Gourmet</span>
              </div>
            </div>
          </div>
          <!-- Carousel Indicators / Dots -->
          <div class="flex justify-center gap-2 mt-2">
            <button class="nosotros-carousel-dot w-2.5 h-2.5 rounded-full bg-brand-gold transition-colors duration-200" data-index="0" aria-label="Ver slide 1"></button>
