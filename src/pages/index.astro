      children.forEach((child, index) => {
        const childCenter = child.offsetLeft + child.getBoundingClientRect().width / 2;
        const containerCenter = scrollLeft + width / 2;
        const distance = Math.abs(childCenter - containerCenter);
        if (distance < minDistance) {
          minDistance = distance;
          activeIndex = index;
        }
      });
      
      nosotrosDots.forEach((dot, index) => {
        if (index === activeIndex) {
          dot.classList.remove('bg-gray-300');
          dot.classList.add('bg-brand-gold');
        } else {
          dot.classList.remove('bg-brand-gold');
          dot.classList.add('bg-gray-300');
        }
      });
    });
    
    nosotrosDots.forEach(dot => {
      dot.addEventListener('click', (e) => {
        const index = parseInt(e.currentTarget.dataset.index);
        const children = Array.from(nosotrosCarousel.children);
        if (children[index]) {
          const slide = children[index];
          const left = slide.offsetLeft - (nosotrosCarousel.clientWidth - slide.getBoundingClientRect().width) / 2;
          nosotrosCarousel.scrollTo({
            left: left,
            behavior: 'smooth'
          });
        }
      });
    });
  }

  // Rewrite static WhatsApp links for desktop users to avoid Facebook redirect errors
  if (!isMobileDev) {
    document.querySelectorAll('a[href*="api.whatsapp.com/send"]').forEach(link => {
      link.href = link.href.replace('api.whatsapp.com/send', 'web.whatsapp.com/send');
    });
  }

  // Force scroll to top on load/refresh (disabling scroll restoration)
  if (window.history && 'scrollRestoration' in window.history) {
    window.history.scrollRestoration = 'manual';
  }
  window.scrollTo(0, 0);
</script>
