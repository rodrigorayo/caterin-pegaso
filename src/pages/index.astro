---
import Layout from '../layouts/Layout.astro';

const whatsappNumber = "59100000000";
const whatsappLink = `https://wa.me/${whatsappNumber}?text=Hola,%20me%20gustar%C3%ADa%20saber%20m%C3%A1s%20sobre%20sus%20planes%20saludables.`;

const plans = [
	{
		name: "Plan Detox Semanal",
		description: "5 días de comidas ligeras para limpiar tu organismo.",
		price: "Bs. 250",
		features: ["Almuerzo y Cena", "Jugos Detox", "Sin azúcares"]
	},
	{
		name: "Plan Fitness Pro",
		description: "Alto en proteínas para ganancia muscular.",
		price: "Bs. 320",
		features: ["Desayuno, Almuerzo, Cena", "Snacks proteicos", "Macros calculados"]
	},
	{
		name: "Plan Keto",
		description: "Bajo en carbohidratos, alto en grasas saludables.",
		price: "Bs. 280",
		features: ["Almuerzo y Cena", "Sin harinas", "Postres Keto"]
	}
];
---

<Layout title="Caterin - Comida Saludable Dark Kitchen">
	<!-- Header -->
	<header class="fixed w-full bg-white/90 backdrop-blur-md z-50 border-b border-green-100 transition-all duration-300">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex justify-between items-center h-20">
				<div class="flex items-center gap-2">
					<div class="w-10 h-10 bg-green-600 rounded-full flex items-center justify-center text-white font-bold text-xl">C</div>
					<span class="font-bold text-2xl text-green-800 tracking-tight">Caterin</span>
				</div>
				<nav class="hidden md:flex gap-8 text-green-900 font-medium">
					<a href="#hero" class="hover:text-green-600 transition-colors">Inicio</a>
					<a href="#como-funciona" class="hover:text-green-600 transition-colors">Cómo Funciona</a>
					<a href="#planes" class="hover:text-green-600 transition-colors">Nuestros Planes</a>
				</nav>
				<a href={whatsappLink} target="_blank" class="bg-green-600 hover:bg-green-700 text-white px-6 py-2.5 rounded-full font-semibold transition-all shadow-md hover:shadow-lg transform hover:-translate-y-0.5">
					Pedir Ahora
				</a>
			</div>
		</div>
	</header>

	<!-- Hero Section -->
	<section id="hero" class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden bg-green-50">
		<!-- Decoración de fondo -->
		<div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 bg-green-200 rounded-full mix-blend-multiply filter blur-3xl opacity-50"></div>
		<div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 bg-green-300 rounded-full mix-blend-multiply filter blur-3xl opacity-50"></div>

		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
			<span class="inline-block py-1 px-3 rounded-full bg-green-100 text-green-800 font-semibold text-sm mb-6 border border-green-200">🥗 100% Fresco y Natural</span>
			<h1 class="text-5xl md:text-7xl font-extrabold text-green-950 mb-8 tracking-tight leading-tight">
				Comida saludable, <br/>
				<span class="text-transparent bg-clip-text bg-gradient-to-r from-green-600 to-green-400">directo a tu puerta</span>
			</h1>
			<p class="text-lg md:text-xl text-green-800 mb-10 max-w-2xl mx-auto leading-relaxed">
				Somos tu Dark Kitchen especializada en planes nutricionales. Preparamos comidas deliciosas, equilibradas y diseñadas para alcanzar tus metas.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a href="#planes" class="bg-white text-green-700 border-2 border-green-600 hover:bg-green-50 px-8 py-4 rounded-full font-bold text-lg transition-all shadow-sm">
					Ver Planes
				</a>
				<a href={whatsappLink} target="_blank" class="bg-green-600 hover:bg-green-500 text-white px-8 py-4 rounded-full font-bold text-lg transition-all shadow-xl hover:shadow-2xl hover:-translate-y-1 flex items-center justify-center gap-2">
					Hablar por WhatsApp
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
				</a>
			</div>
		</div>
	</section>

	<!-- Cómo Funciona -->
	<section id="como-funciona" class="py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-16">
				<h2 class="text-3xl md:text-4xl font-bold text-green-900 mb-4">¿Cómo funciona?</h2>
				<p class="text-green-700 max-w-2xl mx-auto text-lg">Tu comida saludable en 3 simples pasos, sin complicaciones.</p>
			</div>

			<div class="grid md:grid-cols-3 gap-12">
				<div class="text-center p-6 rounded-2xl bg-green-50 border border-green-100 hover:shadow-lg transition-shadow">
					<div class="w-16 h-16 mx-auto bg-green-600 text-white rounded-2xl flex items-center justify-center text-2xl font-bold mb-6 rotate-3">1</div>
					<h3 class="text-xl font-bold text-green-900 mb-3">Elige tu plan</h3>
					<p class="text-green-700">Selecciona el plan que mejor se adapte a tus objetivos (Detox, Keto, Fitness).</p>
				</div>
				<div class="text-center p-6 rounded-2xl bg-green-50 border border-green-100 hover:shadow-lg transition-shadow">
					<div class="w-16 h-16 mx-auto bg-green-600 text-white rounded-2xl flex items-center justify-center text-2xl font-bold mb-6 -rotate-3">2</div>
					<h3 class="text-xl font-bold text-green-900 mb-3">Cocinamos para ti</h3>
					<p class="text-green-700">Nuestros chefs preparan tus comidas diariamente con ingredientes frescos.</p>
				</div>
				<div class="text-center p-6 rounded-2xl bg-green-50 border border-green-100 hover:shadow-lg transition-shadow">
					<div class="w-16 h-16 mx-auto bg-green-600 text-white rounded-2xl flex items-center justify-center text-2xl font-bold mb-6 rotate-3">3</div>
					<h3 class="text-xl font-bold text-green-900 mb-3">Recibe y disfruta</h3>
					<p class="text-green-700">Entregamos tus comidas directamente en tu puerta. Solo calienta y disfruta.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Planes Section -->
	<section id="planes" class="py-24 bg-green-900 text-white relative">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-16">
				<h2 class="text-3xl md:text-5xl font-bold mb-6">Nuestros Planes</h2>
				<p class="text-green-100 max-w-2xl mx-auto text-lg">Planes diseñados por nutricionistas y preparados por chefs. Empieza a cuidarte hoy mismo.</p>
			</div>

			<div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
				{plans.map((plan) => (
					<div class="bg-white text-green-900 rounded-3xl p-8 shadow-2xl flex flex-col transform transition hover:-translate-y-2 hover:shadow-green-900/50">
						<h3 class="text-2xl font-bold mb-2">{plan.name}</h3>
						<p class="text-green-700 mb-6 flex-grow">{plan.description}</p>
						<div class="mb-6">
							<span class="text-4xl font-extrabold">{plan.price}</span>
							<span class="text-green-600 font-medium text-sm">/semana</span>
						</div>
						<ul class="mb-8 space-y-3">
							{plan.features.map((feature) => (
								<li class="flex items-center text-green-800 font-medium">
									<svg class="w-5 h-5 mr-3 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
									{feature}
								</li>
							))}
						</ul>
						<a href={whatsappLink} target="_blank" class="w-full bg-green-600 hover:bg-green-700 text-white text-center py-4 rounded-xl font-bold transition-colors text-lg mt-auto shadow-md">
							Comprar Plan
						</a>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- CTA Final -->
	<section class="py-20 bg-green-50">
		<div class="max-w-4xl mx-auto px-4 text-center">
			<h2 class="text-3xl font-bold text-green-900 mb-6">¿Tienes requisitos dietéticos especiales?</h2>
			<p class="text-green-700 mb-8 text-lg">Escríbenos y nuestro equipo de nutrición adaptará el menú exactamente a lo que necesitas.</p>
			<a href={whatsappLink} target="_blank" class="inline-block bg-white text-green-700 border-2 border-green-600 hover:bg-green-100 px-8 py-3 rounded-full font-bold text-lg transition-all shadow-sm">
				Consultar por WhatsApp
			</a>
		</div>
	</section>

	<!-- Footer -->
	<footer class="bg-white border-t border-green-100 py-12">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-6">
			<div class="flex items-center gap-2">
				<div class="w-8 h-8 bg-green-600 rounded-full flex items-center justify-center text-white font-bold">C</div>
				<span class="font-bold text-xl text-green-800">Caterin</span>
			</div>
			<p class="text-green-700 text-sm">© {new Date().getFullYear()} Caterin Dark Kitchen. Todos los derechos reservados.</p>
			<div class="flex gap-4">
				<a href={whatsappLink} target="_blank" class="text-green-600 hover:text-green-800 font-medium">Contactar por WhatsApp</a>
			</div>
		</div>
	</footer>
</Layout>
