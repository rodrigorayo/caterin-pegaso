---

<Layout title="Montalvo Catering - Comida Saludable Directo a tu Oficina">
  <!-- Header / Navigation -->
  <header class="fixed w-full bg-white/95 backdrop-blur-lg z-50 border-b border-brand-light transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-20 md:h-24">
        <!-- Logo -->
        <a href="#hero" class="flex items-center gap-2 md:gap-4 group">
          <div class="w-14 h-14 md:w-20 md:h-20 rounded-full bg-white border border-brand-gold flex flex-col items-center justify-center shadow-sm relative overflow-hidden px-1 md:px-2 shrink-0 group-hover:scale-102 transition-transform">
            <span class="font-cursive text-brand-dark text-lg md:text-2xl leading-none pt-1 md:pt-2">Montalvo</span>
            <div class="w-10 md:w-14 h-[1px] bg-gradient-to-r from-transparent via-brand-gold to-transparent my-0.5 md:my-1"></div>
            <span class="font-sans text-[5px] md:text-[7px] tracking-[0.25em] text-brand-dark font-extrabold leading-none uppercase">Catering</span>
          </div>
          <div class="flex flex-col">
            <span class="font-serif font-extrabold text-lg md:text-2xl text-brand-dark tracking-tight leading-none">Montalvo</span>
            <span class="font-sans text-[8px] md:text-[11px] tracking-[0.3em] text-brand-gold font-bold uppercase mt-0.5 md:mt-1">Catering</span>
          </div>
        </a>
        
        <!-- Desktop Nav -->
        <nav class="hidden lg:flex items-center gap-8 text-xs font-bold uppercase tracking-wider text-gray-600">
          <a href="#hero" class="hover:text-brand-gold transition-colors">Inicio</a>
          <a href="#nosotros" class="hover:text-brand-gold transition-colors">Nosotros</a>
          <a href="#nuestros-bowls" class="hover:text-brand-gold transition-colors">Bowls</a>
          <a href="#carbs" class="hover:text-brand-gold transition-colors">Carbohidratos</a>
          <a href="#planes" class="hover:text-brand-gold transition-colors">Planes</a>
          <a href="#equipo" class="hover:text-brand-gold transition-colors">Equipo</a>
        </nav>

        <!-- CTA & Mobile Menu Toggle -->
        <div class="flex items-center gap-3 md:gap-4">
          <a href={`${baseWhatsappLink}?text=Hola!%20Me%20gustaría%20saber%20más%20sobre%20sus%20servicios%20de%20Montalvo%20Catering.`} target="_blank" class="bg-brand-gold hover:bg-brand-gold-dark text-white px-4 py-2 md:px-6 md:py-2.5 rounded-full font-bold text-[10px] md:text-xs uppercase tracking-wider transition-all shadow-sm hover:shadow-md hover:-translate-y-0.5 whitespace-nowrap">
            Pedir
          </a>
          <!-- Hamburger Button -->
          <button id="mobile-menu-btn" class="lg:hidden text-brand-dark p-2 focus:outline-none">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </button>
        </div>
      </div>
    </div>
    
    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-brand-light">
      <nav class="flex flex-col items-center py-4 space-y-4 text-sm font-bold uppercase tracking-wider text-gray-600 shadow-lg">
        <a href="#hero" class="mobile-link hover:text-brand-gold transition-colors">Inicio</a>
        <a href="#nosotros" class="mobile-link hover:text-brand-gold transition-colors">Nosotros</a>
        <a href="#nuestros-bowls" class="mobile-link hover:text-brand-gold transition-colors">Bowls</a>
        <a href="#carbs" class="mobile-link hover:text-brand-gold transition-colors">Carbohidratos</a>
        <a href="#planes" class="mobile-link hover:text-brand-gold transition-colors">Planes</a>
        <a href="#equipo" class="mobile-link hover:text-brand-gold transition-colors">Equipo</a>
      </nav>
    </div>
  </header>

  <!-- Hero Section -->
  <section id="hero" class="relative pt-44 pb-24 md:pt-56 md:pb-36 bg-cover bg-no-repeat overflow-hidden" style="background-image: url('/media__1781217634034.jpg'); background-position: center top;">
    <!-- Subtle soft shadow layer underneath text card for absolute contrast -->
    <div class="absolute inset-y-0 left-0 w-full lg:w-1/2 bg-gradient-to-r from-brand-light/20 to-transparent pointer-events-none"></div>

    <!-- Dark overlay for mobile only (screens smaller than lg) to improve text readability -->
    <div class="absolute inset-0 bg-black/60 lg:hidden pointer-events-none"></div>

    <!-- Decorative Floating Leaves and Shapes -->
    <div class="absolute top-20 left-10 text-3xl animate-bounce duration-1000 opacity-20 select-none z-10">🍃</div>
    <div class="absolute bottom-20 right-10 text-4xl animate-pulse opacity-20 select-none z-10">🌿</div>
    <div class="absolute -right-20 top-0 w-[500px] h-[500px] bg-brand-gold/5 rounded-full filter blur-3xl pointer-events-none z-10"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid lg:grid-cols-12 gap-12 items-center">
        <!-- Text Content centered on mobile, fully aligned to the far left on desktop -->
        <div class="lg:col-span-8 space-y-8 text-center lg:text-left lg:-ml-12 xl:-ml-24">
          
          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white lg:text-brand-dark leading-tight">
            Catering Gourmet <br class="hidden sm:inline" />
            <span class="text-brand-gold relative inline-block">
              Para Cada Ocasión
              <svg class="absolute left-0 bottom-0 w-full h-2 text-brand-gold-light/45 -z-10" viewBox="0 0 100 10" preserveAspectRatio="none"><path d="M0,7 C30,2 70,2 100,7 L100,10 L0,10 Z" fill="currentColor"></path></svg>
            </span>
          </h1>

          <p class="text-base sm:text-lg text-gray-200 lg:text-gray-700 max-w-xl mx-auto lg:mx-0 leading-relaxed font-sans font-medium">
            Montalvo Catering es tu servicio premium de confianza en Cochabamba. Fusionamos alta cocina gourmet para eventos sociales y corporativos, ensaladas de autor frescas y variados platos balanceados que llevan sabor y distinción a tu mesa.
          </p>

          <div class="flex justify-center lg:justify-start">
            <a href="#planes" class="bg-brand-gold hover:bg-brand-gold-dark text-white font-bold uppercase tracking-wider text-xs px-8 py-4 rounded-full transition-all shadow-md hover:-translate-y-0.5 text-center inline-block">
              Explorar Planes
            </a>
          </div>

          <!-- Feature Flat Columns (No border, no backgrounds, minimal elegant styling, side-by-side on mobile, stacked vertically on desktop) -->
          <div class="grid grid-cols-2 gap-4 sm:gap-6 pt-4 max-w-xl mx-auto lg:flex lg:flex-col lg:gap-6 lg:max-w-none lg:mx-0">
            <div class="flex flex-col lg:flex-row items-center lg:items-start gap-4 text-center lg:text-left">
              <div class="w-12 h-12 rounded-xl bg-brand-gold/15 flex items-center justify-center text-brand-gold shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
              </div>
              <div>
                <h4 class="font-bold text-white lg:text-brand-dark text-sm">Directo a tu Oficina</h4>
                <p class="text-xs text-gray-300 lg:text-gray-500 mt-1 leading-relaxed">Llegamos antes del almuerzo para que comas fresco y en tu horario.</p>
              </div>
            </div>
            <div class="flex flex-col lg:flex-row items-center lg:items-start gap-4 text-center lg:text-left">
              <div class="w-12 h-12 rounded-xl bg-brand-gold-light/20 flex items-center justify-center text-brand-gold lg:text-brand-gold-dark shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div>
                <h4 class="font-bold text-white lg:text-brand-dark text-sm">Nutrición Calculada</h4>
                <p class="text-xs text-gray-300 lg:text-gray-500 mt-1 leading-relaxed">Carbohidratos complejos, grasas buenas y proteínas de alta calidad.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right side spacer: Shows the beautiful food plates layout of the background image -->
        <div class="lg:col-span-4 h-24 lg:h-auto pointer-events-none"></div>
      </div>
    </div>
  </section>
  <!-- Section: Collage - Kitchen Details (Sobre Montalvo Catering) -->
  <section id="nosotros" class="py-24 bg-[#f4ebe1] border-y border-brand-light overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-12 items-center">
        <!-- Collage of images (Left) - Hidden on mobile, shown on desktop -->
        <div class="hidden lg:grid lg:col-span-6 grid-cols-2 gap-4">
          <div class="space-y-4">
            <div class="rounded-3xl overflow-hidden shadow-md transform hover:scale-102 transition-transform duration-300 relative group">
              <img src="/media__1781224279688.jpg" alt="Menú Balanceado" class="w-full object-cover h-64" />
              <div class="absolute inset-0 bg-black/20 flex items-end p-4 opacity-90 transition-opacity">
                <span class="text-white font-bold text-sm tracking-wide bg-brand-dark/40 px-3 py-1.5 rounded-full backdrop-blur-xs">Menú Balanceado</span>
              </div>
            </div>
            <div class="rounded-3xl overflow-hidden shadow-md transform hover:scale-102 transition-transform duration-300 relative group">
              <img src="/media__1781224281635.jpg" alt="Cocina Profesional" class="w-full object-cover h-44" />
              <div class="absolute inset-0 bg-black/20 flex items-end p-4 opacity-90 transition-opacity">
                <span class="text-white font-bold text-sm tracking-wide bg-brand-dark/40 px-3 py-1.5 rounded-full backdrop-blur-xs">Cocina Profesional</span>
              </div>
            </div>
          </div>
          <div class="space-y-4 pt-8">
            <div class="rounded-3xl overflow-hidden shadow-md transform hover:scale-102 transition-transform duration-300 relative group">
              <img src="/media__1781224283556.jpg" alt="Insumos Ecológicos" class="w-full object-cover h-44" />
              <div class="absolute inset-0 bg-black/20 flex items-end p-4 opacity-90 transition-opacity">
                <span class="text-white font-bold text-sm tracking-wide bg-brand-dark/40 px-3 py-1.5 rounded-full backdrop-blur-xs">Insumos Ecológicos</span>
              </div>
            </div>
            <div class="rounded-3xl overflow-hidden shadow-md transform hover:scale-102 transition-transform duration-300 relative group">
              <img src="/media__1781224285406.jpg" alt="Catering Gourmet" class="w-full object-cover h-64" />
              <div class="absolute inset-0 bg-black/20 flex items-end p-4 opacity-90 transition-opacity">
                <span class="text-white font-bold text-sm tracking-wide bg-brand-dark/40 px-3 py-1.5 rounded-full backdrop-blur-xs">Catering Gourmet</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Carousel for mobile only (screens smaller than lg) -->
        <div class="lg:hidden w-full min-w-0 overflow-hidden relative">
          <!-- Scrollable image track with CSS snap -->
          <div id="nosotros-carousel" class="flex gap-4 overflow-x-auto snap-x snap-mandatory scrollbar-none pb-4 scroll-smooth" style="scrollbar-width: none; -ms-overflow-style: none;">
            <!-- Slide 1 -->
            <div class="snap-center shrink-0 w-4/5 sm:w-2/3 relative rounded-3xl overflow-hidden aspect-[4/3] shadow-md">
              <img src="/media__1781224279688.jpg" alt="Menú Balanceado" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent flex items-end p-4">
                <span class="text-white font-bold text-sm tracking-wide bg-brand-dark/40 px-3 py-1.5 rounded-full backdrop-blur-xs">Menú Balanceado</span>
              </div>
            </div>
            <!-- Slide 2 -->
            <div class="snap-center shrink-0 w-4/5 sm:w-2/3 relative rounded-3xl overflow-hidden aspect-[4/3] shadow-md">
              <img src="/media__1781224281635.jpg" alt="Cocina Profesional" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent flex items-end p-4">
                <span class="text-white font-bold text-sm tracking-wide bg-brand-dark/40 px-3 py-1.5 rounded-full backdrop-blur-xs">Cocina Profesional</span>
              </div>
            </div>
            <!-- Slide 3 -->
            <div class="snap-center shrink-0 w-4/5 sm:w-2/3 relative rounded-3xl overflow-hidden aspect-[4/3] shadow-md">
              <img src="/media__1781224283556.jpg" alt="Insumos Ecológicos" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent flex items-end p-4">
                <span class="text-white font-bold text-sm tracking-wide bg-brand-dark/40 px-3 py-1.5 rounded-full backdrop-blur-xs">Insumos Ecológicos</span>
              </div>
            </div>
            <!-- Slide 4 -->
            <div class="snap-center shrink-0 w-4/5 sm:w-2/3 relative rounded-3xl overflow-hidden aspect-[4/3] shadow-md">
              <img src="/media__1781224285406.jpg" alt="Catering Gourmet" class="w-full h-full object-cover" />
