        <div id="modal-tab-content-customize" class="space-y-6">
          <!-- Size Selection -->
          <div class="space-y-3">
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-500">1. Elige el Tamaño</label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <label class="relative flex items-center justify-between p-4 rounded-xl border border-gray-200 hover:border-brand-gold bg-white cursor-pointer group transition-all">
                <input type="radio" name="modal-size" value="mediano" class="modal-size-radio absolute opacity-0" checked />
                <div class="flex flex-col">
                  <span class="font-bold text-sm text-gray-700">Mediano</span>
                  <span class="text-xs text-gray-400">~400g de balance</span>
                </div>
                <span id="modal-price-mediano-badge" class="font-bold text-brand-gold-dark text-sm">Bs. 24</span>
              </label>
              <label class="relative flex items-center justify-between p-4 rounded-xl border border-gray-200 hover:border-brand-gold bg-white cursor-pointer group transition-all">
                <input type="radio" name="modal-size" value="grande" class="modal-size-radio absolute opacity-0" />
                <div class="flex flex-col">
                  <span class="font-bold text-sm text-gray-700">Grande</span>
                  <span class="text-xs text-gray-400">~650g de rendimiento</span>
                </div>
                <span id="modal-price-grande-badge" class="font-bold text-brand-gold-dark text-sm">Bs. 37</span>
              </label>
            </div>
          </div>

          <!-- Protein Selection -->
          <div class="space-y-3">
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-500">2. Elige tu Proteína</label>
            <div id="modal-protein-container" class="space-y-2">
              <!-- Dynamically populated or statically styled radio options -->
            </div>
          </div>

          <!-- Fixed Ingredients Info -->
          <div class="bg-brand-light/40 p-4 rounded-2xl border border-brand-light/80 space-y-3">
            <span class="block text-xs font-bold uppercase tracking-wider text-brand-gold-dark">Ingredientes Base Incluidos:</span>
            <div class="space-y-2 text-xs text-gray-600">
              <div class="flex items-start gap-2">
                <strong class="text-gray-700 w-20 shrink-0">Carbohidrato:</strong>
                <span id="modal-fixed-carb" class="text-gray-600">Quinua Real</span>
              </div>
              <div class="flex items-start gap-2">
                <strong class="text-gray-700 w-20 shrink-0">Vegetales:</strong>
                <span id="modal-fixed-veg" class="text-gray-600">Mix del Wok</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Tab Content: Nutrition -->
        <div id="modal-tab-content-nutrition" class="hidden space-y-6">
          <!-- Macros grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center">
            <div class="bg-brand-light p-3 rounded-2xl border border-gray-100">
              <span class="block text-[10px] uppercase text-gray-400 font-bold">Calorías</span>
              <span id="modal-nutr-kcal" class="block text-xs font-extrabold text-brand-dark mt-1">200 kcal</span>
            </div>
            <div class="bg-brand-light p-3 rounded-2xl border border-gray-100">
              <span class="block text-[10px] uppercase text-gray-400 font-bold">Proteínas</span>
              <span id="modal-nutr-protein" class="block text-xs font-extrabold text-brand-dark mt-1">25g</span>
            </div>
            <div class="bg-brand-light p-3 rounded-2xl border border-gray-100">
              <span class="block text-[10px] uppercase text-gray-400 font-bold">Carbos</span>
              <span id="modal-nutr-carbs" class="block text-xs font-extrabold text-brand-dark mt-1">18-22g</span>
            </div>
            <div class="bg-brand-light p-3 rounded-2xl border border-gray-100">
              <span class="block text-[10px] uppercase text-gray-400 font-bold">Grasas</span>
              <span id="modal-nutr-fat" class="block text-xs font-extrabold text-brand-dark mt-1">4g</span>
            </div>
          </div>

          <!-- Extra info: Fibra & Vitaminas -->
          <div class="bg-brand-light/40 p-4 rounded-2xl border border-brand-light/80 text-xs space-y-2">
            <div class="flex justify-between">
              <strong class="text-gray-700">Fibra Alimentaria:</strong>
              <span id="modal-nutr-fiber" class="text-brand-gold-dark font-bold">4.5 g</span>
            </div>
            <div class="flex justify-between">
              <strong class="text-gray-700">Vitaminas Clave:</strong>
              <span id="modal-nutr-vitamins" class="text-brand-gold-dark font-bold">A, C, K + Antiox.</span>
            </div>
          </div>

          <!-- Recipe Ingredients list -->
          <div class="space-y-2">
            <h4 class="text-xs font-bold uppercase tracking-wider text-gray-500">Ingredientes de la Receta</h4>
            <div id="modal-nutr-ingredients-list" class="space-y-1.5 max-h-[180px] overflow-y-auto pr-1">
              <!-- Dynamically populated ingredients -->
            </div>
          </div>

          <!-- Daily percentage values -->
          <div class="space-y-3">
            <h4 class="text-xs font-bold uppercase tracking-wider text-gray-500">¿Cuánto Aporte Diario Te Da?</h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Male percentages -->
              <div class="bg-gray-50 p-3 rounded-2xl border border-gray-100 text-[11px] space-y-2">
                <span class="block font-bold text-gray-700 text-center border-b border-gray-200/80 pb-1">Hombre (70 kg)</span>
                <div id="modal-nutr-pct-male" class="space-y-1">
                  <!-- Dynamically populated daily percentages for male -->
                </div>
              </div>
              
              <!-- Female percentages -->
              <div class="bg-gray-50 p-3 rounded-2xl border border-gray-100 text-[11px] space-y-2">
                <span class="block font-bold text-gray-700 text-center border-b border-gray-200/80 pb-1">Mujer (55 kg)</span>
                <div id="modal-nutr-pct-female" class="space-y-1">
                  <!-- Dynamically populated daily percentages for female -->
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Action Footer -->
      <div class="p-6 border-t border-gray-100 bg-gray-50 flex items-center justify-between gap-4">
        <div>
          <span class="block text-[10px] uppercase text-gray-400 font-bold tracking-wider">Total a pagar:</span>
          <span id="modal-total-price" class="text-2xl font-extrabold text-brand-dark">Bs. 24</span>
        </div>
        <a id="modal-whatsapp-btn" href="#" target="_blank" class="flex-grow max-w-[200px] bg-brand-gold hover:bg-brand-gold-dark text-white text-center py-3.5 rounded-xl font-bold uppercase tracking-wider text-xs transition-all shadow-md flex items-center justify-center gap-1.5 pointer-events-none opacity-50">
          Pedir por WhatsApp 📲
        </a>
      </div>
    </div>
  </div>
</Layout>

<!-- CLIENT-SIDE SCRIPT FOR INTERACTIVE MODULES -->
<script is:inline define:vars={{ baseWhatsappLink, bowlsWhatsappLink }}>
  // State variables for Plans
  let selectedSize = 'mediano';
  let selectedFreq = 'semanal';

  const planPrices = {
    balance: {
      mediano: { diario: 30, semanal: 140, mensual: 520 },
      grande: { diario: 40, semanal: 190, mensual: 720 }
    }
  };

  const planFrequenciesText = {
    diario: '/día',
    semanal: '/semana',
    mensual: '/mes'
  };

  const planDescriptionsText = {
    mediano: {
      diario: 'Tamaño Mediano (~400g), Almuerzo diario',
      semanal: 'Tamaño Mediano (~400g), Lunes a Viernes (5 días)',
      mensual: 'Tamaño Mediano (~400g), 4 semanas (20 días)'
    },
    grande: {
      diario: 'Tamaño Grande (~650g), Almuerzo diario',
      semanal: 'Tamaño Grande (~650g), Lunes a Viernes (5 días)',
      mensual: 'Tamaño Grande (~650g), 4 semanas (20 días)'
    }
  };

  function updatePlansUI() {
    // Pricing
    const balancePriceVal = planPrices.balance[selectedSize][selectedFreq];
    const suffix = planFrequenciesText[selectedFreq];

    const priceBalanceEl = document.getElementById('price-balance');
    const periodBalanceEl = document.getElementById('period-balance');

    if (priceBalanceEl) priceBalanceEl.textContent = `Bs. ${balancePriceVal}`;
    if (periodBalanceEl) periodBalanceEl.textContent = suffix;

    // Descriptions
    const descText = planDescriptionsText[selectedSize][selectedFreq];
    const descBalanceEl = document.getElementById('desc-balance');

    if (descBalanceEl) descBalanceEl.textContent = descText;

    // Buy Button Links
    const sizeTextReadable = selectedSize === 'mediano' ? 'Mediano (~400g)' : 'Grande (~650g)';
    const freqTextReadable = selectedFreq === 'diario' ? 'Diario (1 día)' : selectedFreq === 'semanal' ? 'Semanal (5 días)' : 'Mensual (20 días)';
    
    const btnBuyBalanceEl = document.getElementById('btn-buy-balance');

    if (btnBuyBalanceEl) {
      btnBuyBalanceEl.href = `${baseWhatsappLink}?text=Hola!%20Me%20interesa%20suscribirme%20al%20*Plan%20Montalvo*%20%0A-%20Tamaño:%20${encodeURIComponent(sizeTextReadable)}%0A-%20Frecuencia:%20${encodeURIComponent(freqTextReadable)}%0A-%20Precio:%20Bs.%20${balancePriceVal}`;
    }
  }

  // Setup plan toggles
  document.querySelectorAll('.size-toggle-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.size-toggle-btn').forEach(b => {
        b.classList.remove('bg-brand-gold', 'text-white');
        b.classList.add('text-gray-600', 'hover:text-brand-gold');
      });
      e.target.classList.add('bg-brand-gold', 'text-white');
      e.target.classList.remove('text-gray-600', 'hover:text-brand-gold');
      
      selectedSize = e.target.dataset.size;
      updatePlansUI();
    });
  });

  document.querySelectorAll('.freq-toggle-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.freq-toggle-btn').forEach(b => {
        b.classList.remove('bg-brand-gold', 'text-white');
        b.classList.add('text-gray-600', 'hover:text-brand-gold');
      });
      e.target.classList.add('bg-brand-gold', 'text-white');
      e.target.classList.remove('text-gray-600', 'hover:text-brand-gold');

      selectedFreq = e.target.dataset.freq;
      updatePlansUI();
    });
  });



  // Predefined Bowls Popup Modal State & Logic
  let currentBowlData = {
    id: '',
    name: '',
    prices: {},
    selectedSize: 'mediano',
    selectedProtein: '',
    carb: '',
    veg: ''
  };

  const orderModal = document.getElementById('order-modal');
  const modalBowlTitle = document.getElementById('modal-bowl-title');
  const modalProteinContainer = document.getElementById('modal-protein-container');
  const modalFixedCarb = document.getElementById('modal-fixed-carb');
  const modalFixedVeg = document.getElementById('modal-fixed-veg');
  const modalTotalPrice = document.getElementById('modal-total-price');
  const modalWhatsappBtn = document.getElementById('modal-whatsapp-btn');

  // Tabs DOM elements
  const tabBtnCustomize = document.getElementById('modal-tab-btn-customize');
  const tabBtnNutrition = document.getElementById('modal-tab-btn-nutrition');
  const tabContentCustomize = document.getElementById('modal-tab-content-customize');
  const tabContentNutrition = document.getElementById('modal-tab-content-nutrition');

  function switchModalTab(tab) {
    if (tab === 'customize') {
      tabContentCustomize?.classList.remove('hidden');
      tabContentNutrition?.classList.add('hidden');

      tabBtnCustomize?.classList.add('border-brand-gold', 'text-brand-gold-dark');
      tabBtnCustomize?.classList.remove('border-transparent', 'text-gray-500');

      tabBtnNutrition?.classList.remove('border-brand-gold', 'text-brand-gold-dark');
      tabBtnNutrition?.classList.add('border-transparent', 'text-gray-500');
    } else {
      tabContentCustomize?.classList.add('hidden');
      tabContentNutrition?.classList.remove('hidden');

      tabBtnCustomize?.classList.remove('border-brand-gold', 'text-brand-gold-dark');
      tabBtnCustomize?.classList.add('border-transparent', 'text-gray-500');

      tabBtnNutrition?.classList.add('border-brand-gold', 'text-brand-gold-dark');
      tabBtnNutrition?.classList.remove('border-transparent', 'text-gray-500');
    }
  }

  tabBtnCustomize?.addEventListener('click', () => switchModalTab('customize'));
  tabBtnNutrition?.addEventListener('click', () => switchModalTab('nutrition'));

  function openModal(name, id, prices, proteins, carb, veg, nutrition) {
    currentBowlData = {
      id,
      name,
      prices,
      selectedSize: 'mediano',
      selectedProtein: proteins[0] || '',
      carb,
      veg
    };

    // Set title
    if (modalBowlTitle) modalBowlTitle.textContent = name;
    
    // Reset to customization tab by default
    switchModalTab('customize');

    // Reset size radio selection
    document.querySelectorAll('.modal-size-radio').forEach(radio => {
      if (radio.value === 'mediano') {
        radio.checked = true;
        radio.parentElement.classList.add('border-brand-gold', 'bg-brand-light/60');
      } else {
        radio.checked = false;
        radio.parentElement.classList.remove('border-brand-gold', 'bg-brand-light/60');
      }
    });

    // Populate protein options
    if (modalProteinContainer) {
      modalProteinContainer.innerHTML = '';
      proteins.forEach((prot, index) => {
        const label = document.createElement('label');
        label.className = 'relative flex items-center justify-between p-3.5 rounded-xl border border-gray-200 hover:border-brand-gold bg-white cursor-pointer transition-all';
        if (index === 0) {
          label.classList.add('border-brand-gold', 'bg-brand-light/60');
        }
        
        const input = document.createElement('input');
        input.type = 'radio';
        input.name = 'modal-protein';
        input.value = prot;
        input.className = 'modal-protein-radio absolute opacity-0';
        if (index === 0) input.checked = true;
        
        input.addEventListener('change', (e) => {
          document.querySelectorAll('input[name="modal-protein"]').forEach(inp => {
            inp.parentElement.classList.remove('border-brand-gold', 'bg-brand-light/60');
          });
          e.target.parentElement.classList.add('border-brand-gold', 'bg-brand-light/60');
          currentBowlData.selectedProtein = e.target.value;
          updateModalWhatsappLink();
        });

        const spanText = document.createElement('span');
        spanText.className = 'font-bold text-sm text-gray-700';
        spanText.textContent = prot;

        const check = document.createElement('span');
        check.className = 'text-brand-gold font-bold';
        check.textContent = '✓';

        label.appendChild(input);
        label.appendChild(spanText);
        label.appendChild(check);
        modalProteinContainer.appendChild(label);
      });
    }

    // Set fixed values
    if (modalFixedCarb) modalFixedCarb.textContent = carb;
    if (modalFixedVeg) modalFixedVeg.textContent = veg;

    // Set badge prices
    const priceMedianoBadge = document.getElementById('modal-price-mediano-badge');
    const priceGrandeBadge = document.getElementById('modal-price-grande-badge');
    if (priceMedianoBadge) priceMedianoBadge.textContent = `Bs. ${prices.mediano}`;
    if (priceGrandeBadge) priceGrandeBadge.textContent = `Bs. ${prices.grande}`;

    // Populate nutrition information
    if (nutrition) {
      const kcalEl = document.getElementById('modal-nutr-kcal');
      const proteinEl = document.getElementById('modal-nutr-protein');
      const carbsEl = document.getElementById('modal-nutr-carbs');
      const fatEl = document.getElementById('modal-nutr-fat');
      const fiberEl = document.getElementById('modal-nutr-fiber');
      const vitaminsEl = document.getElementById('modal-nutr-vitamins');
      const ingredientsListEl = document.getElementById('modal-nutr-ingredients-list');
      const pctMaleEl = document.getElementById('modal-nutr-pct-male');
      const pctFemaleEl = document.getElementById('modal-nutr-pct-female');

      if (kcalEl) kcalEl.textContent = `${nutrition.kcal} kcal`;
      if (proteinEl) proteinEl.textContent = nutrition.protein;
      if (carbsEl) carbsEl.textContent = nutrition.carbs;
      if (fatEl) fatEl.textContent = nutrition.fat;
      if (fiberEl) fiberEl.textContent = nutrition.fiber;
      if (vitaminsEl) vitaminsEl.textContent = nutrition.vitamins;

      if (ingredientsListEl) {
        ingredientsListEl.innerHTML = '';
        if (nutrition.ingredients && Array.isArray(nutrition.ingredients)) {
          nutrition.ingredients.forEach(ing => {
            const div = document.createElement('div');
            div.className = 'flex justify-between items-center text-xs py-1 border-b border-gray-100/50';
            div.innerHTML = `
              <span class="text-gray-600">${ing.name}</span>
              <span class="font-bold text-gray-800">${ing.weight}</span>
            `;
            ingredientsListEl.appendChild(div);
          });
        }
      }

      if (pctMaleEl) {
        pctMaleEl.innerHTML = '';
        if (nutrition.dailyPct && Array.isArray(nutrition.dailyPct.male)) {
          nutrition.dailyPct.male.forEach(pct => {
            const div = document.createElement('div');
            div.className = 'flex justify-between items-center text-[10px] py-0.5';
            div.innerHTML = `
              <span class="text-gray-500">${pct.name}:</span>
              <span class="font-extrabold text-brand-dark">${pct.val}</span>
            `;
            pctMaleEl.appendChild(div);
          });
        }
      }

      if (pctFemaleEl) {
        pctFemaleEl.innerHTML = '';
        if (nutrition.dailyPct && Array.isArray(nutrition.dailyPct.female)) {
          nutrition.dailyPct.female.forEach(pct => {
            const div = document.createElement('div');
            div.className = 'flex justify-between items-center text-[10px] py-0.5';
            div.innerHTML = `
              <span class="text-gray-500">${pct.name}:</span>
              <span class="font-extrabold text-brand-dark">${pct.val}</span>
            `;
            pctFemaleEl.appendChild(div);
          });
        }
      }
    }

    updateModalPriceHighlight();
    updateModalWhatsappLink();

    // Show modal
    if (orderModal) {
      orderModal.classList.remove('hidden');
      orderModal.offsetHeight; // force reflow
      orderModal.classList.remove('opacity-0');
      orderModal.querySelector('.relative').classList.remove('scale-95');
      orderModal.querySelector('.relative').classList.add('scale-100');
    }
    document.body.classList.add('overflow-hidden');
  }

  function closeModal() {
    if (orderModal) {
      orderModal.classList.add('opacity-0');
      orderModal.querySelector('.relative').classList.remove('scale-100');
      orderModal.querySelector('.relative').classList.add('scale-95');
      setTimeout(() => {
        orderModal.classList.add('hidden');
      }, 300);
    }
    document.body.classList.remove('overflow-hidden');
  }

  function updateModalPriceHighlight() {
    const price = currentBowlData.prices[currentBowlData.selectedSize];
    if (modalTotalPrice) modalTotalPrice.textContent = `Bs. ${price}`;

    document.querySelectorAll('.modal-size-radio').forEach(radio => {
      if (radio.checked) {
        radio.parentElement.classList.add('border-brand-gold', 'bg-brand-light/60');
      } else {
        radio.parentElement.classList.remove('border-brand-gold', 'bg-brand-light/60');
      }
    });
  }

  function updateModalWhatsappLink() {
    const price = currentBowlData.prices[currentBowlData.selectedSize];
    const sizeText = currentBowlData.selectedSize === 'mediano' ? 'Mediano' : 'Grande';
    const message = `Hola Montalvo Catering! Quiero pedir el *${currentBowlData.name}*:\n- Tamaño: ${sizeText}\n- Proteína: ${currentBowlData.selectedProtein}\n- Carbohidrato: ${currentBowlData.carb}\n- Vegetales: ${currentBowlData.veg}\nPrecio: Bs. ${price}`;
    
    if (modalWhatsappBtn) {
      modalWhatsappBtn.href = `${bowlsWhatsappLink}?text=${encodeURIComponent(message)}`;
      modalWhatsappBtn.classList.remove('pointer-events-none', 'opacity-50');
    }
  }

  // Bind Open Buttons
  document.querySelectorAll('.open-modal-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget;
      const name = target.dataset.bowlName;
      const id = target.dataset.bowlId;
      const prices = JSON.parse(target.dataset.bowlPrices);
      const proteins = JSON.parse(target.dataset.bowlProteins);
      const carb = target.dataset.bowlCarb;
      const veg = target.dataset.bowlVeg;
      const nutrition = JSON.parse(target.dataset.bowlNutrition || '{}');
      
      openModal(name, id, prices, proteins, carb, veg, nutrition);
    });
  });

  // Bind Close Button & Backdrop
  document.getElementById('close-modal-btn')?.addEventListener('click', closeModal);
  document.getElementById('modal-backdrop')?.addEventListener('click', closeModal);

  // Bind Size Radio changes
  document.querySelectorAll('.modal-size-radio').forEach(radio => {
    radio.addEventListener('change', (e) => {
      currentBowlData.selectedSize = e.target.value;
      updateModalPriceHighlight();
      updateModalWhatsappLink();
    });
  });

  // Init
  updatePlansUI();

  // Mobile Menu Logic
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    // Close menu when a link is clicked
    document.querySelectorAll('.mobile-link').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }

  // Nosotros Carousel mobile slider logic
  const nosotrosCarousel = document.getElementById('nosotros-carousel');
  const nosotrosDots = document.querySelectorAll('.nosotros-carousel-dot');
  
  if (nosotrosCarousel && nosotrosDots.length > 0) {
    nosotrosCarousel.addEventListener('scroll', () => {
      const scrollLeft = nosotrosCarousel.scrollLeft;
      const width = nosotrosCarousel.clientWidth;
      const children = Array.from(nosotrosCarousel.children);
      let activeIndex = 0;
      let minDistance = Infinity;
      
      children.forEach((child, index) => {
        const childCenter = child.offsetLeft + child.getBoundingClientRect().width / 2;
        const containerCenter = scrollLeft + width / 2;
        const distance = Math.abs(childCenter - containerCenter);
        if (distance < minDistance) {
          minDistance = distance;
          activeIndex = index;
        }
      });
      
      nosotrosDots.forEach((dot, index) => {
        if (index === activeIndex) {
          dot.classList.remove('bg-gray-300');
          dot.classList.add('bg-brand-gold');
        } else {
          dot.classList.remove('bg-brand-gold');
          dot.classList.add('bg-gray-300');
        }
      });
    });
    
    nosotrosDots.forEach(dot => {
      dot.addEventListener('click', (e) => {
        const index = parseInt(e.currentTarget.dataset.index);
        const children = Array.from(nosotrosCarousel.children);
        if (children[index]) {
          const slide = children[index];
          const left = slide.offsetLeft - (nosotrosCarousel.clientWidth - slide.getBoundingClientRect().width) / 2;
          nosotrosCarousel.scrollTo({
            left: left,
            behavior: 'smooth'
          });
        }
      });
    });
  }

  // Force scroll to top on load/refresh (disabling scroll restoration)
  if (window.history && 'scrollRestoration' in window.history) {
    window.history.scrollRestoration = 'manual';
  }
  window.scrollTo(0, 0);
</script>
